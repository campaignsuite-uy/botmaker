# Variables de entorno de la app del equipo (apps/web). SOLO LOS NOMBRES: los valores nunca van en este archivo, ni en
# el chat, ni en documentos. Para usarlas en la Mac: copiá este archivo a .env.local (que no se sube), con permisos 600 y
# los valores entre comillas dobles. En Vercel se cargan en Project → Settings → Environment Variables.

# ── Datos ───────────────────────────────────────────────────────────────────────────────────────
# "demo" (por defecto): todo en memoria, sin cuentas. "supabase": el proyecto de Supabase de desarrollo.
CAMPAIGNSUITE_DATOS=

# ── Supabase ────────────────────────────────────────────────────────────────────────────────────
# Project Settings → API. La URL y la clave pública (anon o publishable) pueden llegar al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (service_role o secret): salta las reglas por fila. SOLO servidor: nunca con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Dirección de la app para la vuelta de Google (en la Mac, http://localhost:3000; en Vercel, la del proyecto).
CAMPAIGNSUITE_URL=

# ── Motores (OpenRouter), una clave por uso ─────────────────────────────────────────────────────
# En desarrollo alcanza la misma clave en las tres. Sin ninguna, "Probar motor" dice qué falta.
BOTS_OPENROUTER_API_KEY_VIVO=
BOTS_OPENROUTER_API_KEY_COPILOTO=
BOTS_OPENROUTER_API_KEY_FONDO=
# 1: todo al motor simulado (sin costo). 0: nunca. Vacío: simulado en la demo y real con Supabase.
BOTS_SIMULAR=
