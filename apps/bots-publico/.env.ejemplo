# Variables de entorno de la app pública (apps/bots-publico). SOLO LOS NOMBRES: los valores nunca van en este archivo,
# ni en el chat, ni en documentos. En la Mac: copiá este archivo a .env.local (que no se sube), con permisos 600 y los
# valores entre comillas dobles. En Vercel: Project → Settings → Environment Variables del proyecto de la app pública.

# ── Datos ───────────────────────────────────────────────────────────────────────────────────────
# "demo" (por defecto): en memoria, con un bot publicado de prueba. "supabase": la base, con la clave de servicio.
CAMPAIGNSUITE_DATOS=
NEXT_PUBLIC_SUPABASE_URL=
# Clave de servicio: la app pública solo llama a las funciones bots.publico_* y bots.tarea_*. SOLO servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ── Motores: la clave del bot en vivo ───────────────────────────────────────────────────────────
BOTS_OPENROUTER_API_KEY_VIVO=
BOTS_SIMULAR=

# ── Protección y contactos ──────────────────────────────────────────────────────────────────────
# HMAC de los contactos y de las IP (se genera en la computadora: openssl rand -hex 32). Obligatoria con Supabase.
BOTS_HASH_SECRET=
# Cloudflare Turnstile (anti-robots). La del sitio llega al navegador; la secreta, solo al servidor. Sin ellas, no se
# verifica (desarrollo): Canales lo avisa.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Tareas de fondo ─────────────────────────────────────────────────────────────────────────────
# El cron de Vercel manda CRON_SECRET en Authorization. Sin clave, /api/tareas no corre.
CRON_SECRET=
